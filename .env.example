# MT5 MCP Bridge — Environment Variables
# Copy this to .env and fill in your credentials

# MT5 Bridge credentials
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# Bridge connection settings (defaults)
MT5_BRIDGE_HOST=localhost
MT5_BRIDGE_PORT=8001

# Optional: Economic Calendar API
EARNINGS_API_KEY=your_api_key_here

# Optional: MCP transport (stdio or sse)
MCP_TRANSPORT=stdio
